layout(local_size_x = 256) in;

float calculate_density(uint i);

void main(){
	uint i = gl_GlobalInvocationID.x;
    if (i >= COUNT) return;

    density[i] = vec2(calculate_density(i),0);
    float pressureForce = density[i].x / sim.target_density;
    pressure[i] = max(0.0f, sim.stiffness * (pow(pressureForce, 7.0f) - 1.0f));

