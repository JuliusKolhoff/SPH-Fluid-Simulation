//A Survey on SPH Methods in Computer Graphics Page 3: 2.4 Mass Density Estimation
float calculate_density(uint i) {

    float densitySum = 0;
    NEIGHBOR_LOOP_BEGIN(pi, j)
        float densityContribution = poly6(r2);
        densitySum += mass[j] * densityContribution;
    NEIGHBOR_LOOP_END           
    return densitySum;
}
