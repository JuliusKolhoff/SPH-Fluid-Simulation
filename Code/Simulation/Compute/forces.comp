#version 430
#include "simulation_helper.glsl"
#include "sim_params.glsl"
#include "gridhelper.glsl"

layout(local_size_x = 256) in;

void calculate_forces(uint i);
vec3 calculate_pressure_contribution(uint i,uint j);
vec3 calculate_viscosity_contribution(uint i,uint j);

void main(){
	uint i = gl_GlobalInvocationID.x;
    if (i >= COUNT) return;

    calculate_forces(i);
}


void calculate_forces(uint i) {

    vec3  pi = pos[i].xyz;
    ivec3 c  = cellCoord(pi);

    accel[i] = vec4(0);

    for (int dz = -1; dz <= 1; dz++) {
        int z = c.z + dz;
        if (z < 0 || z >= GRID_DIMS.z) continue;

        for (int dy = -1; dy <= 1; dy++) {
            int y = c.y + dy;
            if (y < 0 || y >= GRID_DIMS.y) continue;

            int x0 = max(c.x - 1, 0);
            int x1 = min(c.x + 1, GRID_DIMS.x - 1);
            uint s0 = cell_start[cellIndex(ivec3(x0, y, z))];
            uint s1 = cell_start[cellIndex(ivec3(x1, y, z)) + 1u];

            for (uint s = s0; s < s1; s++) {
                uint  j  = sorted_ids[s];
                vec3  d  = pi - pos[j].xyz;
                float r2 = dot(d, d);
                if (r2 > H2) continue;

                accel[i].xyz += -calculate_pressure_contribution(i,j); // MOve Away from pressure
                accel[i].xyz += calculate_viscosity_contribution(i,j);
                
                vec3 externalForces = vec3(0);
                
            }
        }
    }
    accel[i].xyz += vec3(0, -sim.gravity, 0);

}

vec3 calculate_pressure_contribution(uint i,uint j){
    float r = distance(pos[i].xyz, pos[j].xyz);
    if (r < 1e-6f) return vec3(0);
    vec3 direction = (pos[i].xyz - pos[j].xyz) / r;
    float contribution = spikyGrad(r);
    vec3 acceleration = mass[j] * ((pressure[i] / (density[i].x * density[i].x)) + (pressure[j] / (density[j].x * density[j].x))) * contribution * direction;
    return acceleration;
}

vec3 calculate_viscosity_contribution(uint i,uint j){
    const float d = 3.0f;
    const float prefactor = 2.0f * (d + 2.0f);   // = 10
    float safe_density = max(density[i].x, 1e-4f);

    const float eps = 0.01f * H2;  // regularisation term

    vec3 x_ij = pos[i].xyz - pos[j].xyz;
    vec3 v_ij = vel[i].xyz - vel[j].xyz;
    float r = length(x_ij);
    if (r < 1e-6f) return vec3(0);

    float W1_val = spikyGrad(r);
    vec3  grad_W = W1_val * (x_ij / r);

    float dot_vx = dot(v_ij, x_ij);
    float denom = dot(x_ij, x_ij) + eps;

    vec3 contribution = (mass[j] / density[j].x) * (dot_vx / denom) * grad_W;


    return (sim.viscosity/safe_density) * prefactor * contribution;
}