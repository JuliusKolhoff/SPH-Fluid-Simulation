vec3 calculate_pressure_contribution(uint i,uint j){
    float r = distance(pos[i].xyz, pos[j].xyz);
    if (r < 1e-6f) return vec3(0);
    vec3 direction = (pos[i].xyz - pos[j].xyz) / r;
    float contribution = spikyGrad(r);
    vec3 acceleration = mass[j] * ((pressure[i] / (density[i].x * density[i].x)) + (pressure[j] / (density[j].x * density[j].x))) * contribution * direction;
    return acceleration;
}

vec3 calculate_viscosity_contribution(uint i,uint j){
    const float d = 3.0f;
    const float prefactor = 2.0f * (d + 2.0f);   // = 10
    float safe_density = max(density[i].x, 1e-4f);

    const float eps = 0.01f * H2;  // regularisation term

    vec3 x_ij = pos[i].xyz - pos[j].xyz;
    vec3 v_ij = vel[i].xyz - vel[j].xyz;
    float r = length(x_ij);
    if (r < 1e-6f) return vec3(0);

    float W1_val = spikyGrad(r);
    vec3  grad_W = W1_val * (x_ij / r);

    float dot_vx = dot(v_ij, x_ij);
    float denom = dot(x_ij, x_ij) + eps;

    vec3 contribution = (mass[j] / density[j].x) * (dot_vx / denom) * grad_W;


    return (sim.viscosity/safe_density) * prefactor * contribution;
}