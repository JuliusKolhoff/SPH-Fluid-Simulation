#version 430
#include "simulation_helper.glsl"
#include "sim_params.glsl"
#include "gridhelper.glsl"
layout(local_size_x = 256) in;

void calculate_forces(uint i);
vec3 calculate_pressure_contribution(uint i,uint j);
vec3 calculate_viscosity_contribution(uint i,uint j);

void main(){
	uint i = gl_GlobalInvocationID.x;
    if (i >= COUNT) return;

    calculate_forces(i);
}
void calculate_forces(uint i) {
    const vec3  xi    = pos[i].xyz;
    const vec3  vi    = vel[i].xyz;
    const float rhoi  = density[i].x;
    const float Pi    = pressure[i] / (rhoi * rhoi);
    const float viscK = (sim.viscosity / max(rhoi, 1e-4)) * 10.0;  // 2*(d+2), d=3
    const float eps   = 0.01 * H2;

    vec3 acc = vec3(0.0, -sim.gravity, 0.0);

    NEIGHBOR_LOOP_BEGIN(i, j)
        if (r2 > 1e-12) {
            float r    = sqrt(r2);
            float rhoj = density[j].x;
            float Pj   = pressure[j] / (rhoj * rhoj);

            float visc = viscK * dot(vi - vel[j].xyz, d) / (rhoj * (r2 + eps));
            float s = mass[j] * (visc - (Pi + Pj));

            acc += (s * spikyGrad(r) / r) * d;
        }
    NEIGHBOR_LOOP_END

    accel[i] = vec4(acc, 0.0);
}

