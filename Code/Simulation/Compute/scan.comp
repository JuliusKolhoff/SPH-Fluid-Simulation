#version 430
#include "gridhelper.glsl"
layout(local_size_x = 1024) in;
shared uint sums[1024];

void main() {  
    uint t = gl_LocalInvocationID.x;

    uint chunk = (NUM_CELLS + 1023u) / 1024u;
    uint begin = t * chunk, end = min(begin + chunk, NUM_CELLS);

    uint total = 0u;
    for (uint k = begin; k < end; k++) total += cell_count[k];
    sums[t] = total;
    barrier();

    for (uint off = 1u; off < 1024u; off <<= 1) {   // inclusive scan of chunk totals
        uint v = (t >= off) ? sums[t - off] : 0u;
        barrier();
        sums[t] += v;
        barrier();
    }

    uint run = sums[t] - total;                      // exclusive offset of this chunk
    for (uint k = begin; k < end; k++) { cell_start[k] = run; run += cell_count[k]; }
    if (t == 1023u) cell_start[NUM_CELLS] = sums[t];
}